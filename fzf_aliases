#!/bin/zsh
# fzf_aliases — interactive pickers for files, git branches/commits, and dirty files.

# ─── shared helpers ────────────────────────────────────────────────────────────

# Compact one-line `git log` with refs, used by fcoc and fsh. Forwards args (e.g. a path).
_git_log_compact() {
    git log --color=always \
        --format="%C(auto)%h %s %C(bold black)%cr %C(cyan)%an" "$@"
}

# fzf --preview snippet: show the commit at the selected line through delta.
# Stored as a multi-line string (not a function) because fzf runs preview commands
# in a fresh `sh -c` subshell that can't see zsh functions defined in the parent.
# {} is expanded by fzf (the highlighted line); $hash is expanded by sh at run time.
_view_git_log_line='
    hash=$(echo {} | grep -o "[a-f0-9]\{7\}" | head -1)
    git show --color=always "$hash" | delta --features=diff-so-fancy --paging=always
'

# ─── file & content search ─────────────────────────────────────────────────────

# fzz — fzf file picker. Multi-select with tab; prints one file per line.
fzz() {
    fzf --multi \
        --preview "bat --style=numbers,changes,header --theme=gruvbox-light --color=always --line-range :500 {}" \
        --preview-window=right:60% \
        --bind 'ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down'
}

# nf / lf / bf — pick file(s) with fzz, open in nvim / less / bat, then on exit
# print the absolute path(s) so the picked file isn't lost from the scrollback,
# and copy them to the clipboard (delete the xclip line to disable).
_fzz_open() {
    local opener=$1 files
    files=$(fzz) || return
    [[ -z $files ]] && return
    local -a paths=("${(f)files}")            # one selected file per line
    "$opener" "${paths[@]}"                   # blocks until you exit
    paths=("${paths[@]:A}")                    # -> absolute paths
    print -Pn "%F{green}↪ opened:%f "; print -r -- "${(j:, :)paths}"
    command -v xclip >/dev/null && print -rn -- "${(pj:\n:)paths}" | xclip -selection clipboard
}
nf() { _fzz_open nvim; }
lf() { _fzz_open less; }
bf() { _fzz_open bat;  }

# rf — ripgrep + fzf, basename-prefixed for fast filename matching.
# tab to multi-select; opens one buffer per matched file (first match shown at
# its line, the rest loaded) and loads *every* match into the quickfix list
rf() {
    local out
    out=$(rg --color=always --line-number --no-heading --smart-case \
       --max-columns=200 --max-columns-preview --colors='path:none' "${*:-}" |
       awk -F: '{
           n = split($1, p, "/")
           print "\033[1;35m" p[n] "\033[0m:" $0
       }' |
       fzf --ansi --multi \
           --header 'enter: nvim · ctrl-l: less' \
           --color "hl:-1:underline,hl+:-1:underline:reverse" \
           --delimiter : \
           --with-nth=1,3.. \
           --bind 'ctrl-l:execute(less +{3} {2})' \
           --preview 'bat --theme=gruvbox-light --color=always {2} --highlight-line {3}' \
           --preview-window 'right,50%,border-left,+{3}+3/3,~3') || return
    [[ -z $out ]] && return

    setopt local_options extended_glob
    local -a nvim_args
    local -A seen
    local line file lineno text qf
    local -i n=0
    qf=$(mktemp) || qf=
    while IFS= read -r line; do
        line=${line//$'\e'\[[0-9;]##m/}   # strip ANSI, just in case
        [[ -z $line ]] && continue
        line=${line#*:}                   # drop the basename column
        file=${line%%:*}                  # full path
        line=${line#*:}
        lineno=${line%%:*}                # line number
        text=${line#*:}                   # match text
        (( n++ ))
        [[ -n $qf ]] && print -r -- "$file:$lineno:$text" >> $qf   # quickfix entry
        (( $+seen[$file] )) && continue   # one buffer per file
        seen[$file]=1
        if (( ${#nvim_args} == 0 )); then
            nvim_args+=("+$lineno" "$file")
        else
            nvim_args+=(-c "badd +$lineno ${file// /\\ }")
        fi
    done <<< "$out"
    [[ -n $qf && $n -gt 1 ]] && nvim_args+=(-c "cgetfile $qf" -c "copen" -c "wincmd p")
    (( ${#nvim_args} )) && nvim "${nvim_args[@]}"
    [[ -n $qf ]] && rm -f $qf
}

# ─── system ────────────────────────────────────────────────────────────────────

# fkill — pick processes to kill (multi-select). Defaults to -TERM; pass another signal as $1.
fkill() {
    local sig=${1:--TERM}
    local pids
    pids=$(ps -ef | sed 1d | fzf --multi --header='select processes to kill' | awk '{print $2}') || return
    [[ -n $pids ]] && echo "$pids" | xargs kill "$sig"
}

# fj — pick a suspended job to resume. enter: fg · ctrl-b: bg (continue in background)
# Captures `jobs -l` to a tempfile first because the builtin doesn't see the parent
# shell's job table when called inside $(...).
fj() {
    local tmp out key line jid
    tmp=$(mktemp) || return
    jobs -l > $tmp
    if ! grep -qiE 'suspended|stopped' $tmp; then
        echo "no suspended jobs" >&2
        rm -f $tmp
        return 1
    fi
    out=$(grep -iE 'suspended|stopped' $tmp |
        fzf --no-sort --no-multi --ansi \
            --expect=ctrl-b \
            --header 'enter: fg · ctrl-b: bg' \
            --preview '
                pid=$(echo {} | sed "s/^\[[0-9]*\]//" | grep -oE "[0-9]+" | head -1)
                [ -n "$pid" ] && {
                    ps -p $pid -o pid,user,%cpu,%mem,etime,stat,command 2>/dev/null
                    echo
                    command -v pstree >/dev/null && pstree -p $pid 2>/dev/null
                }
            ' \
            --preview-window=down:40%)
    rm -f $tmp
    [[ -z $out ]] && return
    key=${out%%$'\n'*}
    line=${out##*$'\n'}
    jid=${${line%%]*}#\[}
    [[ -z $jid ]] && return
    if [[ $key == ctrl-b ]]; then
        bg %$jid
    else
        fg %$jid
    fi
}

# ─── git: branches, tags, commits ──────────────────────────────────────────────

# fco — checkout a branch or tag (with commit-list preview)
fco() {
    local blue=$'\e[1;34m' magenta=$'\e[1;35m' reset=$'\e[m'
    local current branches_and_tags target name

    current=$(git symbolic-ref --short HEAD 2>/dev/null)
    branches_and_tags=$(
        git for-each-ref --format='%(refname:short)' refs/heads refs/remotes \
            | grep -v '/HEAD$' \
            | grep -vx "$current" \
            | awk -v c="$blue" -v r="$reset" '{print c "branch" r "\t" $1}'
        git --no-pager tag \
            | awk -v c="$magenta" -v r="$reset" '{print c "tag" r "\t" $1}'
    )
    target=$(fzf --no-hscroll --no-multi -n 2 --ansi \
                 --preview="git --no-pager log -150 --pretty=format:%s '..{2}'" <<<"$branches_and_tags") || return
    name=$(awk '{print $2}' <<<"$target")
    git checkout "${name#origin/}"
}

# fcoc — checkout a commit
fcoc() {
    local commit
    commit=$(_git_log_compact |
        fzf --reverse --tiebreak=index --no-multi --ansi \
            --preview="$_view_git_log_line") &&
        git checkout "${commit%% *}"
}

# fsh — git commit browser with diff preview
fsh() {
    _git_log_compact "$@" |
        fzf --ansi --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
            --preview="$_view_git_log_line" \
            --preview-window=right:40% \
            --bind "enter:execute:$_view_git_log_line"
}

# frl — reflog browser (for "I lost a commit, help"). Pick to checkout.
frl() {
    local entry
    entry=$(git reflog --color=always |
        fzf --ansi --no-sort --preview="$_view_git_log_line") || return
    git checkout "${entry%% *}"
}

# fstash — pick a stash. Enter pops; ctrl-a applies (keep stash); ctrl-d drops.
fstash() {
    local entry
    entry=$(git stash list --color=always |
        fzf --ansi --no-sort \
            --preview='git stash show -p --color=always $(echo {} | cut -d: -f1)' \
            --header 'enter: pop · ctrl-a: apply · ctrl-d: drop' \
            --bind 'ctrl-a:become(git stash apply $(echo {} | cut -d: -f1))' \
            --bind 'ctrl-d:become(git stash drop $(echo {} | cut -d: -f1))') || return
    git stash pop "${entry%%:*}"
}

# fconflicts — open conflicting files (during merge/rebase) in nvim
fconflicts() {
    local files
    files=$(git diff --name-only --diff-filter=U |
        fzf --multi --preview='git diff --color=always -- {}') || return
    [[ -n $files ]] && nvim ${(f)files}
}

# fbd — browse local branches and delete them explicitly (multi-select).
# ctrl-d deletes selected branches, ctrl-alt-d force deletes (-D)
fbd() {
    # skip current branch (*) and branches checked out in worktrees (+) — git won't delete those.
    # master/main are excluded so they can't be deleted, even by accident.
    local list="git branch | grep -v '^[*+]' | awk '{print \$1}' | grep -vxE 'master|main'"
    eval "$list" |
        fzf --multi --preview='git log --color=always --oneline -20 {}' \
            --header='ctrl-d: delete | ctrl-alt-d: force delete' \
            --color='header:blue,footer:red' \
            --bind='enter:ignore' \
            --bind="ctrl-d:transform-footer(git branch -d {+} 2>&1)+reload($list)" \
            --bind="ctrl-alt-d:transform-footer(git branch -D {+} 2>&1)+reload($list)" \
            --bind='zero:become(echo "no (more) matching branches" >&2)' \
        >/dev/null
}

# fmr — pick a GitLab MR to check out (requires glab and jq)
fmr() {
    local mr iid
    mr=$(glab mr list --output=json |
        jq -r '.[] | "\(.iid)\t\(.title)\t\(.author.username)"' |
        fzf --delimiter='\t' --with-nth=1,2 \
            --preview='glab mr view {1}') || return
    iid=$(awk -F'\t' '{print $1}' <<<"$mr")
    glab mr checkout "$iid"
}

# fcs — cd into a submodule
fcs() {
    local root subdir
    root=$(git rev-parse --show-superproject-working-tree 2>/dev/null)
    [[ -z $root ]] && { root=$(git rev-parse --show-toplevel) || return; }
    subdir=$(git config --file "$root/.gitmodules" --get-regexp path | awk '{print $2}' | fzf) || return
    [[ -d $root/$subdir ]] && cd "$root/$subdir"
}

# ─── git: dirty files (modified + untracked) ───────────────────────────────────

# Shared picker for dirty/untracked files. Extra fzf args are forwarded.
_fzf_dirty_files() {
    git ls-files -m -o --deduplicate --exclude-standard |
        fzf --multi \
            --preview '
                if git ls-files --error-unmatch -- {} >/dev/null 2>&1; then
                    git diff --color=always -- {}
                else
                    bat --color=always --style=plain {} 2>/dev/null || cat {}
                fi
            ' \
            --preview-window=right:60% \
            "$@"
}

# ng — open dirty files in nvim. No arg: working-tree dirty/untracked files.
# With N (e.g. `ng 1`): files changed in the Nth commit behind HEAD (ng 1 = HEAD).
ng() {
    local files
    if [[ -n $1 ]]; then
        files=$(git diff-tree --no-commit-id --name-only -r "HEAD~$(($1 - 1))") || return
    else
        files=$(git ls-files -m -o --deduplicate --exclude-standard) || return
    fi
    [[ -n $files ]] && nvim ${(f)files}
}

# ga — fuzzy git add of dirty files
ga() {
    local files
    files=$(_fzf_dirty_files) || return
    [[ -n $files ]] && git add -- ${(f)files}
}

# gr — fuzzy git restore of dirty files
gr() {
    local files
    files=$(_fzf_dirty_files) || return
    [[ -n $files ]] && git restore -- ${(f)files}
}

# Ctrl-G — inline picker that pastes selections onto the prompt
fzf-git-dirty-widget() {
    setopt localoptions pipefail no_aliases 2>/dev/null
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
        zle -M "not in a git repo"; return
    }
    local selected
    selected=$(_fzf_dirty_files --header 'git dirty files — tab: multi-select')
    local ret=$?
    if (( ret == 0 )) && [[ -n $selected ]]; then
        local line files=()
        while IFS= read -r line; do
            [[ -z $line ]] && continue
            files+=("${(q)line}")
        done <<< "$selected"
        LBUFFER="${LBUFFER}${files[*]} "
    fi
    zle reset-prompt
    return $ret
}
zle -N fzf-git-dirty-widget
bindkey -M emacs '^G' fzf-git-dirty-widget
bindkey -M viins '^G' fzf-git-dirty-widget
bindkey -M vicmd '^G' fzf-git-dirty-widget

# ─── completions ───────────────────────────────────────────────────────────────

# Make `fsh` complete its args the same way `git log` does (paths, refs, --since=, etc.)
compdef _git fsh=git-log
