#!/bin/bash

alias glNoGraph='git log --color=always --format="%C(auto)%h%d %s %C(bold black)%cr %C(cyan)%an" "$@"'
_gitLogLineToHash="echo {} | grep -o '[a-f0-9]\{7\}' | head -1"
_viewGitLogLine="$_gitLogLineToHash | xargs -I % sh -c 'git show --color=always % | delta --features=diff-so-fancy --paging=always'"

# Fzf with preview
fzz(){
    fzf --preview "bat --style=numbers,changes --theme=gruvbox-light --color=always --line-range :500 {}" \
        --preview-window=right:60% \
        --bind 'ctrl-k:preview-half-page-up,ctrl-j:preview-half-page-down' \
        $@;
}

## fbr - checkout git branch (including remote branches)
fbr() {
  local branches branch
  branches=$(git branch --all | grep -v HEAD) &&
  branch=$(echo "$branches" |
           fzf-tmux -d $(( 2 + $(wc -l <<< "$branches") )) +m) &&
  git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

# fco_preview - checkout git branch/tag, with a preview showing the commits between the tag/branch and HEAD
fco() {
    local tags branches target branch
    branches=$(
        git --no-pager branch --all \
            --format="%(if)%(HEAD)%(then)%(else)%(if:equals=HEAD)%(refname:strip=3)%(then)%(else)%1B[0;34;1mbranch%09%1B[m%(refname:short)%(end)%(end)" \
        | sed '/^$/d') || return
    tags=$(
        git --no-pager tag | awk '{print "\x1b[35;1mtag\x1b[m\t" $1}') || return
    target=$(
        (echo "$branches"; echo "$tags") |
        fzf --no-hscroll --no-multi -n 2 \
            --ansi --preview="git --no-pager log -150 --pretty=format:%s '..{2}'") || return
    branch=$(awk '{print $2}' <<<"$target" | sed 's#origin/##')
    git checkout $branch
}


# fcoc_preview - checkout git commit with previews
fcoc() {
  local commit
  commit=$( glNoGraph |
    fzf --no-sort --reverse --tiebreak=index --no-multi \
        --ansi --preview="$_viewGitLogLine" ) &&
  git checkout $(echo "$commit" | sed "s/ .*//")
}

# fshow - git commit browser
fsh() {
  git log --graph --color=always \
      --format="%C(auto)%h %s %C(bold black)%cr %C(cyan)%an" "$@" |
  fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
      --preview="$_viewGitLogLine" \
      --bind "enter:execute:$_viewGitLogLine"
}

fcs() {
    subdir=$(git submodule--helper list | awk '{print $4}' |  fzf)
    if [[ -e $subdir ]]; then
        cd $subdir
    fi
}

rf() {
    rg --color=always --line-number --no-heading --smart-case \
        --max-columns=200 --max-columns-preview --colors='path:none' "${*:-}" |
        awk -F: 'BEGIN{OFS=":"} {
            n = split($1, p, "/")
            rest = $0; sub(/^[^:]*:/, "", rest)
            print "\033[1;35m" p[n] "\033[0m", $1 ":" rest
        }' |
            fzf --ansi \
            --color "hl:-1:underline,hl+:-1:underline:reverse" \
            --delimiter : \
            --with-nth=1,3.. \
            --preview 'bat --color=always {2} --highlight-line {3}' \
            --preview-window 'right,60%,border-left,+{3}+3/3,~3' \
            --bind 'enter:become(nvim {2} +{3})'
}

# Ctrl-G — inline picker for git dirty files (mirrors fzf's ctrl-t)
fzf-git-dirty-widget() {
  setopt localoptions pipefail no_aliases 2>/dev/null
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    zle -M "not in a git repo"; return
  }
  local selected
  selected=$(
    git ls-files -m -o --exclude-standard |
      fzf -m \
          --header 'git dirty files — tab: multi-select' \
          --preview '
            if git ls-files --error-unmatch -- {} >/dev/null 2>&1; then
              git diff --color=always -- {}
            else
              bat --color=always --style=plain {} 2>/dev/null || cat {}
            fi
          ' \
        --preview-window=right:60% \
  )
  local ret=$?
  if (( ret == 0 )) && [[ -n $selected ]]; then
    local line files=()
    while IFS= read -r line; do
      [[ -z $line ]] && continue
      files+=("${(q)line}")
    done <<< "$selected"
    LBUFFER="${LBUFFER}${files[*]} "
  fi
  zle reset-prompt
  return $ret
}
zle -N fzf-git-dirty-widget
bindkey -M emacs '^G' fzf-git-dirty-widget
bindkey -M viins '^G' fzf-git-dirty-widget
bindkey -M vicmd '^G' fzf-git-dirty-widget

# ga - fuzzy git add of dirty files
ga() {
  local files
  files=$(git ls-files -m -o --exclude-standard | fzf --multi) || return
  [[ -z $files ]] && return
  git add -- ${(f)files}
}

# gr - fuzzy git restore of dirty files
gr() {
  local files
  files=$(git ls-files -m -o --exclude-standard | fzf --multi) || return
  [[ -z $files ]] && return
  git restore -- ${(f)files}
}
